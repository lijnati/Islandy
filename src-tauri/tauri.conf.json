{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Islandy",
  "version": "0.3.2",
  "identifier": "com.islandy.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "island",
        "title": "Islandy",
        "width": 220,
        "height": 44,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "focus": false,
        "focusable": false,
        "dragDropEnabled": false,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "font-src": "'self'",
        "img-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self'",
        "img-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost ws://localhost:1420"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "A beautiful, context-aware Dynamic Island for Windows.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "Islandy",
        "languages": ["English"],
        "compression": "lzma"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "longDescription": "Islandy is a floating island at the top of your screen that shows media, system status and developer activity such as Claude Code sessions. Everything stays on your PC: no account, no cloud, no telemetry.",
    "publisher": "Islandy",
    "copyright": "© 2026 Islandy contributors",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ0MTAwNjZCMjMyOUU1RTEKUldUaDVTa2phd1lRMUNZbXZCaTZBcUd1MllIM2lRYnJjeGEvMHY0a21zaUd1dFNPV0htTDhKM1kK",
      "endpoints": ["https://github.com/lijnati/Islandy/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
