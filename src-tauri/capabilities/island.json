{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "island",
  "description": "Least-privilege capability for the island window: only Islandy's own typed commands. No core or plugin permissions are granted (the global shortcut is registered from Rust).",
  "windows": ["island"],
  "permissions": [
    "allow-get-app-info",
    "allow-connect-island",
    "allow-get-island-layouts",
    "allow-set-island-frame",
    "allow-set-island-interactive",
    "allow-open-system-settings",
    "allow-connect-media",
    "allow-get-media-snapshot",
    "allow-select-media-session",
    "allow-media-control",
    "allow-media-seek",
    "allow-get-media-artwork",
    "allow-connect-system",
    "allow-get-system-snapshot",
    "allow-set-system-focus",
    "allow-set-master-volume",
    "allow-set-audio-muted",
    "allow-set-radio-state",
    "allow-set-display-brightness",
    "allow-connect-activity",
    "allow-get-activity-snapshot",
    "allow-dismiss-activity",
    "allow-answer-permission",
    "allow-clear-activity-history",
    "allow-set-quiet-mode",
    "allow-set-activity-source",
    "allow-get-claude-integration",
    "allow-install-claude-integration",
    "allow-remove-claude-integration",
    "allow-connect-settings",
    "allow-update-settings",
    "allow-preview-island-offset",
    "allow-open-settings-window",
    "allow-get-weather"
  ]
}
